+package xhttp
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"net"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/metacubex/http"
+)
+
+type pipelineTransport func(*http.Request) (*http.Response, error)
+
+func (f pipelineTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func pipelineResponse(status int) *http.Response {
+	return &http.Response{StatusCode: status, Status: strconv.Itoa(status), Body: io.NopCloser(strings.NewReader(""))}
+}
+func pipelineWriter(tr http.RoundTripper) *PacketUpWriter {
+	ctx, cancel := context.WithCancel(context.Background())
+	w := &PacketUpWriter{ctx: ctx, cancel: cancel, cfg: &Config{Host: "example.test", Path: "/t/", UplinkDataPlacement: PlacementHeader, UplinkDataKey: "X-Data", UplinkChunkSize: "2048"}, scMaxEachPostBytes: 2048, scMinPostsIntervalMs: Range{Min: 1, Max: 1}, sessionID: "session", transport: tr}
+	w.writeCond = sync.Cond{L: &w.writeMu}
+	return w
+}
+func TestPacketPipelineConcurrencyAndIntegrity(t *testing.T) {
+	entered := make(chan struct{}, 32)
+	release := make(chan struct{})
+	rows := map[int][]byte{}
+	var mu sync.Mutex
+	w := pipelineWriter(pipelineTransport(func(r *http.Request) (*http.Response, error) {
+		parts := strings.Split(strings.TrimRight(r.URL.Path, "/"), "/")
+		seq, err := strconv.Atoi(parts[len(parts)-1])
+		if err != nil {
+			return nil, err
+		}
+		var encoded string
+		for i := 0; ; i++ {
+			v := r.Header.Get(fmt.Sprintf("X-Data-%d", i))
+			if v == "" {
+				break
+			}
+			encoded += v
+		}
+		b, err := base64.RawURLEncoding.DecodeString(encoded)
+		if err != nil {
+			return nil, err
+		}
+		mu.Lock()
+		rows[seq] = b
+		mu.Unlock()
+		entered <- struct{}{}
+		select {
+		case <-release:
+			return pipelineResponse(200), nil
+		case <-r.Context().Done():
+			return nil, r.Context().Err()
+		}
+	}))
+	defer w.Close()
+	data := make([]byte, 24*2048)
+	for i := range data {
+		data[i] = byte(i / 2048)
+	}
+	done := make(chan error, 1)
+	go func() { _, e := w.Write(data); done <- e }()
+	for i := 0; i < 16; i++ {
+		select {
+		case <-entered:
+		case <-time.After(2 * time.Second):
+			t.Fatal("packets serialized before previous response")
+		}
+	}
+	select {
+	case <-entered:
+		t.Fatal("unbounded pipeline")
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("write stuck")
+	}
+	w.Close()
+	mu.Lock()
+	defer mu.Unlock()
+	var got []byte
+	for i := 0; i < len(rows); i++ {
+		got = append(got, rows[i]...)
+	}
+	if !bytes.Equal(data, got) {
+		t.Fatalf("payload corrupted: got %d want %d", len(got), len(data))
+	}
+}
+func TestPacketPipelineFailureUnblocksWriter(t *testing.T) {
+	w := pipelineWriter(pipelineTransport(func(r *http.Request) (*http.Response, error) { return pipelineResponse(413), nil }))
+	defer w.Close()
+	done := make(chan error, 1)
+	go func() { _, err := w.Write(make([]byte, 128*2048)); done <- err }()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("upload failure hidden")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("write remained blocked")
+	}
+}
+func TestPacketPipelineCloseCancelsStalledRequests(t *testing.T) {
+	w := pipelineWriter(pipelineTransport(func(r *http.Request) (*http.Response, error) { <-r.Context().Done(); return nil, r.Context().Err() }))
+	done := make(chan error, 1)
+	go func() { _, err := w.Write(make([]byte, 128*2048)); done <- err }()
+	time.Sleep(40 * time.Millisecond)
+	start := time.Now()
+	w.Close()
+	w.Close()
+	if time.Since(start) > 1500*time.Millisecond {
+		t.Fatal("unbounded close")
+	}
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("closed write succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("blocked writer leaked")
+	}
+	if _, err := w.Write([]byte("late")); err != net.ErrClosed {
+		t.Fatalf("write after close: %v", err)
+	}
+}
+
+func TestPacketPipelineCancelledContextUnblocksWriter(t *testing.T) {
+	w := pipelineWriter(pipelineTransport(func(r *http.Request) (*http.Response, error) { <-r.Context().Done(); return nil, r.Context().Err() }))
+	defer w.Close()
+	done := make(chan error, 1)
+	go func() { _, err := w.Write(make([]byte, 128*2048)); done <- err }()
+	time.Sleep(40 * time.Millisecond)
+	w.cancel()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("cancelled write succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cancelled writer leaked")
+	}
+}
+
+func TestPacketPipelineBoundsReorderingWindow(t *testing.T) {
+	entered := make(chan struct{}, 128)
+	release := make(chan struct{})
+	w := pipelineWriter(pipelineTransport(func(r *http.Request) (*http.Response, error) {
+		entered <- struct{}{}
+		if strings.HasSuffix(r.URL.Path, "/0") {
+			select {
+			case <-release:
+			case <-r.Context().Done():
+				return nil, r.Context().Err()
+			}
+		}
+		return pipelineResponse(200), nil
+	}))
+	defer w.Close()
+	done := make(chan error, 1)
+	go func() { _, err := w.Write(make([]byte, 64*2048)); done <- err }()
+	for i := 0; i < 16; i++ {
+		select {
+		case <-entered:
+		case <-time.After(time.Second):
+			t.Fatal("missing concurrent packet")
+		}
+	}
+	select {
+	case <-entered:
+		t.Fatal("later acknowledgements exceeded server reassembly window")
+	case <-time.After(100 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("window failed to advance")
+	}
+}
